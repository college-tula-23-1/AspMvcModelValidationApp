@using Microsoft.AspNetCore.Mvc.ModelBinding
@model Employee

<style>
    .field-validation-error,
    .validation-summary-errors {
        color: red;
    }

    input.input-validation-error{
        border: 1px solid red;
    }

    input.valid {
        border: 1px solid green;
    }
</style>

